# Copy to .env and edit. Every value here is the default, so an empty .env works.

# Where the SQLite database lives inside the container. Keep it on the volume.
DB_PATH=/data/hunter.db
PORT=8080
TZ=Europe/Rome

# How often every enabled search is swept, in minutes.
# Solo il valore di partenza: una volta scelto il ritmo dalle Impostazioni,
# comanda quello, salvato nel database.
SWEEP_MINUTES=360

# A listing missing from this many consecutive sweeps is treated as sold.
MISSES_BEFORE_SOLD=2

# Vinted rate-limits hard. Its search returns titles only, so each promising
# listing costs a page fetch; this caps that per sweep.
VINTED_HOST=vinted.it
VINTED_ROTATE_EVERY=10
# Intervallo minimo fra due richieste a Vinted, e come ci si ferma quando dice
# basta: la prima attesa, il tetto a cui arriva raddoppiando, e quanto si è
# disposti ad aspettare dentro una passata prima di saltare Vinted per quel giro.
# Il ritmo si allarga da solo dopo un rifiuto e si restringe dopo una fila di
# risposte buone: questi sono il minimo, il tetto e quanta pazienza serve.
VINTED_MIN_GAP_MS=1100
VINTED_MAX_GAP_MS=6000
VINTED_EASE_AFTER=40
VINTED_COOL_MS=60000
VINTED_MAX_COOL_MS=900000
VINTED_MAX_WAIT_MS=90000
# Budget di letture di pagina per PASSATA INTERA, non per ricerca.
# Il costo di spedizione di Wallapop sta solo nella pagina dell'annuncio: una
# lettura ciascuna, su quelli che corrispondono e non ce l'hanno ancora.
WALLAPOP_MAX_SHIPPING=60
VINTED_MAX_DETAILS=120
