{
  "name": "marketplace-search",
  "version": "1.0.0",
  "private": true,
  "description": "Watches Subito, Wallapop and Vinted for second-hand listings, parses what the adverts say, scores the sellers and keeps price history.",
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "engines": { "node": ">=22.5", "pnpm": ">=10" },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./packages/*\" dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter api start",
    "serve": "pnpm --filter api serve",
    "worker": "pnpm --filter api worker",
    "once": "pnpm --filter api once"
  }
}
